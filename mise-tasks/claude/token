#!/usr/bin/env bash
#MISE description="Write the Claude Code token to Parameter Store (paste it on stdin)"

# The token never passes through git, Terraform state or a repository secret,
# so this task is the only way it is written — and re-running it is the whole
# of rotation. Paste the value from `claude setup-token`, then Ctrl-D.
set -euo pipefail
umask 077
token_file="$(mktemp)"
trap 'rm -f "$token_file"' EXIT
# A pasted token wraps at the terminal width, so the copy can carry line
# breaks. Strip every space before storing: the value has none of its own.
tr -d '[:space:]' > "$token_file"
case "$(cat "$token_file")" in
  sk-ant-oat*) ;;
  *) echo "expected a token starting with sk-ant-oat, from 'claude setup-token'" >&2; exit 1 ;;
esac
aws ssm put-parameter \
  --region ap-northeast-1 \
  --name /claude-code/oauth-token \
  --type SecureString \
  --overwrite \
  --value "file://$token_file" > /dev/null
echo "wrote /claude-code/oauth-token"
