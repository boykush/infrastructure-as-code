#!/usr/bin/env bash
#MISE description="Write a repository's HCP Terraform API token to Parameter Store (paste it on stdin)"
#USAGE arg "<repository>" help="The repository whose CI reads the token: infrastructure-as-code, or one in hcp_terraform_repositories"

# The token never passes through git, Terraform state or a repository secret,
# so this task is the only way it is written — and re-running it is the whole
# of rotation. Issue the token in HCP Terraform (docs/hcp-terraform-token.md),
# paste it, then Ctrl-D. Each repository has its own token and parameter.
set -euo pipefail
repository="${usage_repository:?}"
umask 077
token_file="$(mktemp)"
trap 'rm -f "$token_file"' EXIT
# A pasted token wraps at the terminal width, so the copy can carry line
# breaks. Strip every space before storing: the value has none of its own.
tr -d '[:space:]' > "$token_file"
if [ ! -s "$token_file" ]; then
  echo "no token on stdin" >&2
  exit 1
fi
aws ssm put-parameter \
  --region ap-northeast-1 \
  --name "/hcp-terraform/${repository}" \
  --type SecureString \
  --overwrite \
  --value "file://$token_file" > /dev/null
echo "wrote /hcp-terraform/${repository}"
