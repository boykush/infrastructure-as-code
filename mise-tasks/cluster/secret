#!/usr/bin/env bash
#MISE description="Write one key of a cluster Secret to Parameter Store (paste the value on stdin)"
#USAGE arg "<namespace>" help="Namespace the Secret belongs to"
#USAGE arg "<secret>" help="Name of the Secret"
#USAGE arg "<key>" help="Key within the Secret"

# Where the value of a cluster Secret is written; the ExternalSecret that names
# the parameter brings it in from there. Paste the value, then Ctrl-D. The line
# break a paste ends with is dropped, as a token must not carry one; a PEM keeps
# the ones inside it and loses nothing by it.
set -euo pipefail
umask 077
value_file="$(mktemp)"
trap 'rm -f "$value_file"' EXIT
printf '%s' "$(cat)" > "$value_file"
if [ ! -s "$value_file" ]; then
  echo "nothing on stdin: paste the value, then Ctrl-D" >&2
  exit 1
fi
name="/cluster-secrets/${usage_namespace}/${usage_secret}/${usage_key}"
aws ssm put-parameter \
  --region ap-northeast-1 \
  --name "$name" \
  --type SecureString \
  --overwrite \
  --value "file://$value_file" > /dev/null
echo "wrote $name"
