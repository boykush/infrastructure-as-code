#!/usr/bin/env bash
#MISE description="Mint a new access key for External Secrets Operator into Parameter Store"

# The operator's own access key, which never passes through a terminal: IAM
# hands it to a file and Parameter Store takes it from there. The old keys go
# first, so the user never holds more than one; the cluster keeps the Secrets it
# has and only stops refreshing until the workflow has carried the new key in.
set -euo pipefail
umask 077
user=external-secrets
for id in $(aws iam list-access-keys --user-name "$user" --query 'AccessKeyMetadata[].AccessKeyId' --output text); do
  aws iam delete-access-key --user-name "$user" --access-key-id "$id"
done
key_file="$(mktemp)"
secret_file="$(mktemp)"
trap 'rm -f "$key_file" "$secret_file"' EXIT
aws iam create-access-key --user-name "$user" \
  --query '[AccessKey.AccessKeyId, AccessKey.SecretAccessKey]' --output text > "$key_file"
printf '%s' "$(cut -f2 "$key_file")" > "$secret_file"
aws ssm put-parameter --region ap-northeast-1 --name /external-secrets/access-key-id \
  --type SecureString --overwrite --value "$(cut -f1 "$key_file")" > /dev/null
aws ssm put-parameter --region ap-northeast-1 --name /external-secrets/secret-access-key \
  --type SecureString --overwrite --value "file://$secret_file" > /dev/null
echo "wrote /external-secrets/{access-key-id,secret-access-key}; now: gh workflow run external-secrets-credential.yml"
