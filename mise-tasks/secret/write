#!/usr/bin/env bash
#MISE description="Write a secret to Parameter Store (paste the value on stdin)"
#USAGE arg "<name>" help="Name under /secrets, as <issuer>/<name>: e.g. hcp-terraform/owners"

# The value never passes through git, Terraform state or a repository secret,
# so this task is the only way it is written, and re-running it is the whole of
# rotation. Who may read the parameter is declared in terraform/aws.tf. Paste
# the value, then Ctrl-D.
set -euo pipefail
name="/secrets/${usage_name:?}"
umask 077
value_file="$(mktemp)"
trap 'rm -f "$value_file"' EXIT
# A pasted token wraps at the terminal width, so the copy can carry line breaks.
# Strip every space before storing: no value here has one of its own.
tr -d '[:space:]' > "$value_file"
if [ ! -s "$value_file" ]; then
  echo "nothing on stdin: paste the value, then Ctrl-D" >&2
  exit 1
fi
aws ssm put-parameter \
  --region ap-northeast-1 \
  --name "$name" \
  --type SecureString \
  --overwrite \
  --value "file://$value_file" > /dev/null
echo "wrote $name"
