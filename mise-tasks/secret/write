#!/usr/bin/env bash
#MISE description="Write a secret to Parameter Store (prompts like gh secret set, or reads a pipe)"
#USAGE arg "<name>" help="Name under /secrets, as <issuer>/<name>: e.g. hcp-terraform/owners"

# The value never passes through git, Terraform state or a repository secret,
# so this task is the only way it is written, and re-running it is the whole of
# rotation. Who may read the parameter is declared in terraform/aws.tf.
set -euo pipefail
name="/secrets/${usage_name:?}"
umask 077
value_file="$(mktemp)"
trap 'rm -f "$value_file"' EXIT

# At a terminal the paste is not echoed, as with gh secret set: a value on
# screen ends up in scrollback and in whatever reads the terminal.
if [ -t 0 ]; then
  printf '? Paste your secret: ' >&2
  IFS= read -rs value
  printf '%s\n' "$(printf '%s' "$value" | tr -c '' '*')" >&2
  printf '%s' "$value" | tr -d '[:space:]' > "$value_file"
  unset value
else
  # No value here has a space of its own; a copied token can carry line breaks.
  tr -d '[:space:]' > "$value_file"
fi
if [ ! -s "$value_file" ]; then
  echo "no value given" >&2
  exit 1
fi
aws ssm put-parameter \
  --region ap-northeast-1 \
  --name "$name" \
  --type SecureString \
  --overwrite \
  --value "file://$value_file" > /dev/null
echo "✓ Set $name" >&2
