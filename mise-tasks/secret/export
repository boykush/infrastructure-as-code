#!/usr/bin/env bash
#MISE description="In CI: read secrets from Parameter Store into the job's environment"

# Each argument is ENV=name: the value of /secrets/<name> becomes $ENV for the
# steps that follow, masked in the log first. Run it after assuming a role that
# may read those names (terraform/aws.tf); the roles are the whole of who reads
# what. Every later step of the job sees the values, so keep third-party steps
# out of a job that reads them.
set -euo pipefail
: "${GITHUB_ENV:?runs in GitHub Actions only}"
for pair in "$@"; do
  env_name="${pair%%=*}"
  name="${pair#*=}"
  value="$(aws ssm get-parameter --region ap-northeast-1 --with-decryption \
    --name "/secrets/${name}" --query Parameter.Value --output text)"
  # ::add-mask:: masks line by line, so a second line would reach the log.
  if [[ "$value" == *$'\n'* ]]; then
    echo "/secrets/${name} holds a line break; write it again with mise run secret:write" >&2
    exit 1
  fi
  echo "::add-mask::${value}"
  printf '%s=%s\n' "$env_name" "$value" >> "$GITHUB_ENV"
  echo "read /secrets/${name} into ${env_name}"
done
